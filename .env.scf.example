# 换装相机 腾讯云部署环境变量配置
# 复制此文件为 .env.scf 并填入真实值

# ========== 腾讯云 COS 配置（必填）==========
# 在腾讯云控制台 -> 访问管理 -> API密钥管理 获取
COS_SECRET_ID=your_secret_id
COS_SECRET_KEY=your_secret_key

# COS 存储桶名称，格式：bucketname-appid
# 例如：homeglow-1234567890
COS_BUCKET=your_bucket_name

# COS 地域，与云函数保持一致
COS_REGION=ap-guangzhou

# CDN 加速域名（可选，用于加速图片访问）
COS_CDN_DOMAIN=

# ========== AI 服务配置（必填）==========
IMAGE_GEN_API_KEY=your_image_gen_api_key
IMAGE_GEN_API_URL=https://xiaoai.plus/v1
VLLM_API_KEY=your_vllm_api_key
VLLM_API_URL=https://xiaoai.plus/v1

# ========== 电商 API 配置（选填，至少配置一个）==========

# 拼多多多多进宝
PDD_CLIENT_ID=
PDD_CLIENT_SECRET=
PDD_PID=

# 淘宝联盟
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
TAOBAO_ADZONE_ID=

# 大淘客
DATAOKE_APP_KEY=
DATAOKE_APP_SECRET=

# ========== 日志服务配置（可选）==========
CLS_LOGSET_ID=
CLS_TOPIC_ID=
