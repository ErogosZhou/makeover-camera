# ============================================================
# 换装相机 环境变量配置示例
# ============================================================
# 使用说明：
# 1. 复制此文件为 .env
# 2. 填入真实的 API 密钥
# 3. 根据需求调整配置
# ============================================================

# ------------------------------------------------------------
# 基础配置
# ------------------------------------------------------------

# 调试模式（开发环境设为 true，生产环境设为 false）
DEBUG=true

# 服务地址和端口
HOST=0.0.0.0
PORT=8000

# 上传目录（本地存储）
UPLOAD_DIR=./uploads

# ------------------------------------------------------------
# 图片生成服务配置
# ------------------------------------------------------------

# 生成服务提供商（seedream 或 gemini）
# 推荐：seedream（支持图生图，速度快）
IMAGE_GEN_PROVIDER=seedream

# Seedream/豆包 API 配置
# 获取地址：https://www.volcengine.com/docs/82379/1298454
IMAGE_GEN_API_KEY=your_seedream_api_key_here
IMAGE_GEN_API_URL=https://ark.cn-beijing.volces.com/api/v3
IMAGE_GEN_MODEL=doubao-seedream-4-0-250828

# 备用：Gemini Imagen 3 配置（可选）
# 获取地址：https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_MODEL=gemini-3-pro-image-preview

# ------------------------------------------------------------
# AI 分析服务配置
# ------------------------------------------------------------

# 豆包大模型 API（用于空间分析）
# 获取地址：https://www.volcengine.com/docs/82379/1099475
DOUBAO_API_KEY=your_doubao_api_key_here
DOUBAO_API_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=ep-20241226152828-5h5vn

# Gemini API（用于物品识别）
# 获取地址：https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.0-flash-exp

# ------------------------------------------------------------
# 电商平台配置
# ------------------------------------------------------------

# 拼多多多多进宝 API（必需）
# 获取地址：https://open.pinduoduo.com/
# 说明：
#  - CLIENT_ID: 应用 ID
#  - CLIENT_SECRET: 应用密钥
#  - PID: 推广位 ID（用于佣金结算）
PDD_CLIENT_ID=your_pdd_client_id_here
PDD_CLIENT_SECRET=your_pdd_client_secret_here
PDD_PID=your_pdd_pid_here

# 淘宝联盟 API（可选，暂未启用）
# TAOBAO_APP_KEY=your_taobao_app_key_here
# TAOBAO_APP_SECRET=your_taobao_app_secret_here
# TAOBAO_ADZONE_ID=your_adzone_id_here

# 大淘客 API（可选，暂未启用）
# DATAOKE_APP_KEY=your_dataoke_app_key_here
# DATAOKE_APP_SECRET=your_dataoke_app_secret_here

# ------------------------------------------------------------
# 云存储配置（可选）
# ------------------------------------------------------------

# 腾讯云 COS 对象存储
# 说明：配置后会自动使用 COS 存储图片，否则使用本地存储
# 获取地址：https://console.cloud.tencent.com/cam/capi
# COS_SECRET_ID=your_cos_secret_id_here
# COS_SECRET_KEY=your_cos_secret_key_here
# COS_BUCKET=your-bucket-name
# COS_REGION=ap-beijing

# ------------------------------------------------------------
# 用户认证配置
# ------------------------------------------------------------

# JWT 密钥（生产环境必须修改为随机字符串）
# 生成方法：python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 微信小程序配置（用于用户登录）
# WECHAT_APP_ID=your_wechat_app_id_here
# WECHAT_APP_SECRET=your_wechat_app_secret_here

# ------------------------------------------------------------
# 性能配置
# ------------------------------------------------------------

# HTTP 请求超时（秒）
# 图像生成通常需要 15-30 秒
HTTP_TIMEOUT=120

# 数据库配置（默认使用 SQLite）
# 生产环境可以使用 PostgreSQL/MySQL
# DATABASE_URL=sqlite:///./homeglow.db

# ------------------------------------------------------------
# 日志配置
# ------------------------------------------------------------

# 日志级别（DEBUG | INFO | WARNING | ERROR）
LOG_LEVEL=INFO

# 日志文件路径
# LOG_FILE=./logs/app.log

# ------------------------------------------------------------
# 安全配置
# ------------------------------------------------------------

# 允许的跨域来源（CORS）
# 生产环境应该限制为特定域名
# CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# 文件上传限制（字节）
MAX_UPLOAD_SIZE=10485760  # 10MB

# 允许的图片格式（逗号分隔）
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp

# ------------------------------------------------------------
# 开发者选项
# ------------------------------------------------------------

# 是否启用 API 文档（FastAPI Swagger UI）
ENABLE_DOCS=true

# 是否启用自动重载（开发模式）
RELOAD=true

# ------------------------------------------------------------
# 注意事项
# ------------------------------------------------------------
# 1. 不要将 .env 文件提交到 Git 仓库
# 2. 生产环境必须修改 JWT_SECRET_KEY
# 3. 生产环境建议使用 HTTPS
# 4. 定期检查 API Key 的使用额度
# 5. 备份数据库文件（homeglow.db）
# ============================================================
